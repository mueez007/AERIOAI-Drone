# AERIOAI Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=AERIOAI Mission Intelligence Platform
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=sqlite:///./aerioai.db

# Security (change these!)
JWT_SECRET_KEY=your-random-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Camera (webcam | csi | mock)
CAMERA_SOURCE=mock
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# Flight Controller (mock | msp)
FC_MODE=mock
FC_PORT=/dev/ttyUSB0
FC_BAUDRATE=115200

# AI APIs
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Storage
MEDIA_PATH=../media
MAX_STORAGE_PERCENT=85
CLEANUP_PERCENT=95

# Server
API_HOST=0.0.0.0
API_PORT=8000
